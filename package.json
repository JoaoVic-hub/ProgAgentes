{
  "name": "truco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:client": "npm run dev --workspace apps/client",
    "dev:server": "npm run dev --workspace apps/server",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p packages/truco-rules/tsconfig.json && tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/client/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}